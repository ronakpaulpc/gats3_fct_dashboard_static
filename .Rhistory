) |>
# Calculate Prop and % of HHs Completed across Districts
mutate(
prop_hh = n_hh / tot_hh,
pct_hh = scales::label_percent()(prop_hh)
)
# Check table
df_tbl_progress_psu
# View as datatable
datatable(
df_tbl_progress_psu |> select(-prop_hh),
colnames = c("Districts", "Total HHs", "Completed HHs", "Completion Rate")
)
