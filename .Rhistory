# ** Overall Progress Check -----------------------------------------------
# Overall Progress comes from CONSENT6 var
# Consent distribution table - raw data
data_ex_00 |> tabyl(CONSENT6)
# Consent distribution table - Basic
dt_consent_part00 <- data_ex_01 |>
tabyl(consent_part_fct) |>
adorn_totals()
dt_consent_part00
# Make changes to the consent distribution table For graph
dt_consent_part01 <- dt_consent_part00 |>
# Convert percent scale to 0-100
mutate(percent = percent * 100) |>
rename(
"status_code" = "consent_part_fct",
"pct" = "percent"
) |>
mutate(status = "status", .before = 1) |>
# Remove the Row of Totals
slice(1:(n() - 1))
dt_consent_part01
# Estimate the HH refusal rate
data_ex_01 |> tabyl(CONSENT6)
# Estimate the HH refusal rate
data_ex_01 |>
tabyl(CONSENT6) |>
filter(CONSENT6 == 2) |>
pull(valid_percent)
# Estimate the HH refusal rate
data_ex_01 |>
tabyl(CONSENT6) |>
filter(CONSENT6 == 2) |>
mutate(pct_consent = scales::label_percent()(valid_percent))
# Estimate the HH refusal rate
data_ex_01 |>
tabyl(CONSENT6) |>
filter(CONSENT6 == 2) |>
mutate(pct_consent = scales::label_percent(accuracy = 0.1)(valid_percent))
# Estimate the HH refusal rate
data_ex_01 |>
tabyl(CONSENT6) |>
filter(CONSENT6 == 2) |>
mutate(pct_consent = scales::label_percent(accuracy = 0.2)(valid_percent))
# Estimate the HH refusal rate
data_ex_01 |>
tabyl(CONSENT6) |>
filter(CONSENT6 == 2) |>
mutate(pct_consent = scales::label_percent(accuracy = 0.01)(valid_percent))
# Estimate the HH refusal rate
data_ex_01 |>
tabyl(CONSENT6) |>
filter(CONSENT6 == 2) |>
mutate(
n_consent = str_c(
n,
"(",
scales::label_percent(accuracy = 0.1)(valid_percent),
")"
))
# Estimate the Consent refusal rate
data_consent <- data_ex_01 |>
tabyl(CONSENT6) |>
filter(CONSENT6 == 2) |>
mutate(
