mutate(pct_psu = (n_psu / tot_psu)) |>
# Prepare the Progress Display Stat in N (%)
mutate(stat_psu = str_c(
n_psu,
" (",
scales::label_percent()(pct_psu),
")"
))
# Check Progress
data_progress_psu
data_progress_psu$stat_psu
